<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link rel="stylesheet" href="/stylesheets/login.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
  </head>
  <body>
    <div class="contenedor_general">
      <div class="contenedor_principal">
        <h1>PaparcApp</h1>
        <p>Member Login</p>
        <div class="contenedor_usuarioTrabajador">
          <div class="usuarioTrabajador">
            <button class="usuario">User</button>
            <button class="trabajador">Worker</button>
          </div>
        </div>

        <!-- Worker Login Form -->
        <form action="/users/login" method="POST" class="formWorker">
          <input type="hidden" name="loginType" value="worker" /> <!-- hidden field to indicate login type, simulating different user types -->
          <div class="secciones">
            <label for="worker_email">Worker Email</label>
            <input
              type="text"
              name="email"
              id="worker_email"
              required
              minlength="3"
              maxlength="50"
            />
          </div>
          <div class="seccion">
            <label for="worker_password">Password</label>
            <input
              type="password"
              name="password"
              id="worker_password"
              required
              minlength="8"
              pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
              title="Must contain at least one number, one uppercase, one lowercase, and one special character"
            />
          </div>
          <div class="seccion">
            <label for="employee_id">Employee ID</label>
            <input
              type="text"
              name="employee_id"
              id="employee_id"
              placeholder="Simulation (not required for MVP)"
              minlength="3"
              maxlength="20"
            />
          </div>
          <button type="submit">Login as Worker</button>
        </form>
        <div class="containerUserContent">
          <!-- User Login Form -->
          <form action="/users/login" method="POST" class="formUser">
            <input type="hidden" name="loginType" value="user"> <!-- hidden field to indicate login type, simulating different user types -->
            <div class="secciones">
              <label for="user_email">User Email</label>
              <input
                type="text"
                name="email"
                id="user_email"
                required
                minlength="3"
                maxlength="50"
              />
            </div>
            <div class="seccion">
              <label for="user_password">Password</label>
              <input
                type="password"
                name="password"
                id="user_password"
                required
                minlength="8"
                pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
                title="Must contain at least one number, one uppercase, one lowercase, and one special character"
              />
            </div>
            <button type="submit">Login</button>
          </form>
          <hr />
          <p class="text-center" style="margin-top: 10px;">
            Not registered? <a href="/users/register" style="color: #007bff; text-decoration: underline;">Create account</a>
          </p>
          <div class="botones">
            <button type="button" onclick="loginWithGoogle()">
              <img
                src="https://www.svgrepo.com/show/475656/google-color.svg"
                alt="Google logo"
              />
              <span>Continue with Google</span>
            </button>
            <button type="button" onclick="loginWithFacebook()">
              <img
                src="https://www.svgrepo.com/show/475647/facebook-color.svg"
                alt="Facebook logo"
              />
              <span>Continue with Facebook</span>
            </button>
          </div>
          <a href="/" class="back-home">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/></svg>
            Back to Home
          </a>
        </div>
      </div>
      <!-- Imagen eliminada -->
    </div>
    <script src="/javascripts/login.js"></script>
    <!-- Firebase Auth -->
    <script src="/javascripts/firebase-config.js"></script>
    <script src="/javascripts/firebase-auth.js"></script>
    
    <% if (locals.success) { %>
      <div id="flash-msg" data-type="success" data-text="<%= success %>" style="display:none;"></div>
    <% } %>
    <% if (locals.error) { %>
      <div id="flash-msg" data-type="error" data-text="<%= error %>" style="display:none;"></div>
    <% } %>
    <script src="/javascripts/flash-alert.js"></script>
  </body>
</html>
