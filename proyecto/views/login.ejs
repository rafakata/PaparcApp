<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página de Acceso</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link rel="stylesheet" href="/stylesheets/login.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>
  <body>
    <div class="contenedor_general">
      <div class="contenedor_principal">
        <h1>PaparcApp</h1>
        <p>Member Login</p>
        <div class="contenedor_usuarioTrabajador">
          <div class="usuarioTrabajador">
            <button class="usuario">User</button>
            <button class="trabajador">Worker</button>
          </div>
        </div>

        <!-- Formulario para trabajadores -->
        <form action="/users/login" method="POST" class="formWorker">
          <input type="hidden" name="loginType" value="worker" /> <!-- campo oculto para indicar tipo de login, simulamos diferentes tipos de usuarios -->
          <div class="secciones">
            <label for="worker_email">Worker Email</label>
            <input
              type="text"
              name="email"
              id="worker_email"
              required
              minlength="3"
              maxlength="50"
            />
          </div>
          <div class="seccion">
            <label for="worker_password">Password</label>
            <input
              type="password"
              name="password"
              id="worker_password"
              required
              minlength="8"
              pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
              title="Must contain at least one number, one uppercase, one lowercase, and one special character"
            />
          </div>
          <div class="seccion">
            <label for="employee_id">Employee ID</label>
            <input
              type="text"
              name="employee_id"
              id="employee_id"
              placeholder="Simulación (no requerido para MVP)"
              minlength="3"
              maxlength="20"
            />
          </div>
          <button type="submit">Login Worker</button>
        </form>
        <div class="containerUserContent">
          <!-- Formulario para usuarios -->
          <form action="/users/login" method="POST" class="formUser">
            <input type="hidden" name="loginType" value="user"> <!-- campo oculto para indicar tipo de login, simulamos diferentes tipos de usuarios -->
            <div class="secciones">
              <label for="user_email">User Email</label>
              <input
                type="text"
                name="email"
                id="user_email"
                required
                minlength="3"
                maxlength="50"
              />
            </div>
            <div class="seccion">
              <label for="user_password">Password</label>
              <input
                type="password"
                name="password"
                id="user_password"
                required
                minlength="8"
                pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
                title="Must contain at least one number, one uppercase, one lowercase, and one special character"
              />
            </div>
            <button type="submit">Login</button>
          </form>
          <hr />
          <div class="botones">
            <button>
              <img
                src="https://www.svgrepo.com/show/475656/google-color.svg"
                alt="Google logo"
              />
              <span>Continue with Google</span>
            </button>
            <button>
              <img
                src="https://www.svgrepo.com/show/475647/facebook-color.svg"
                alt="Facebook logo"
              />
              <span>Continue with Facebook</span>
            </button>
          </div>
        </div>
      </div>
      <div class="imagen">
        <img
          src="/images/cceac833.jpg"
          alt="Portal de Acceso"
        />
      </div>
    </div>
    <script src="/javascripts/login.js"></script>
    
    <!-- SweetAlert2: Mensaje de alerta de éxito/error -->

    <% if (locals.success) { %>
      <div id="flash-msg" data-type="success" data-text="<%= success %>" style="display:none;"></div>
    <% } %>
    <% if (locals.error) { %>
      <div id="flash-msg" data-type="error" data-text="<%= error %>" style="display:none;"></div>
    <% } %>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        let flash = document.getElementById('flash-msg');
        if (flash) {
          let type = flash.getAttribute('data-type');
          let bgColor = type === 'success' ? '#eafaf1' : '#fdecea';
          let textColor = type === 'success' ? '#2e7d32' : '#c62828';
          Swal.fire({
            toast: true,
            position: 'bottom-end',
            icon: type,
            title: type === 'success' ? '¡Bien hecho!' : 'Error',
            text: flash.getAttribute('data-text'),
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true,
            width: '520px',
            background: bgColor,
            color: textColor,
            didOpen: function(toast) {
              toast.addEventListener('mouseenter', Swal.stopTimer);
              toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
          });
        }
      });
    </script>
  </body>
</html>
