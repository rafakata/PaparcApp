<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página de Acceso</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link rel="stylesheet" href="/stylesheets/login.css" />
  </head>
  <body>
    <div class="contenedor_general">
      <div class="contenedor_principal">
        <h1>PaparcaApp</h1>
        <p>Member Login</p>
        <div class="contenedor_usuarioTrabajador">
          <div class="usuarioTrabajador">
            <button class="usuario">User</button>
            <button class="trabajador">Worker</button>
          </div>
        </div>
        <!-- Formulario para trabajadores -->
        <form action="/users/login" method="POST" class="formWorker">
          <div class="secciones">
            <label for="worker">Worker</label>
            <input
              type="text"
              name="worker"
              id="worker"
              required
              minlength="3"
              maxlength="50"
            />
          </div>
          <div class="seccion">
            <label for="worker_password">Password</label>
            <input
              type="password"
              name="password"
              id="worker_password"
              required
              minlength="8"
              pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
              title="Must contain at least one number, one uppercase, one lowercase, and one special character"
            />
          </div>
          <div class="seccion">
            <label for="employee_id">Employee ID</label>
            <input
              type="text"
              name="employee_id"
              id="employee_id"
              required
              minlength="3"
              maxlength="20"
            />
          </div>
          <button type="submit">Login Worker</button>
        </form>
        <div class="containerUserContent">
          <!-- Formulario para usuarios -->
          <form action="/users/login" method="POST" class="formUser">
            <div class="secciones">
              <label for="name">User</label>
              <input
                type="text"
                name="user"
                id="user"
                required
                minlength="3"
                maxlength="50"
              />
            </div>
            <div class="seccion">
              <label for="password">Password</label>
              <input
                type="password"
                name="password"
                id="password"
                required
                minlength="8"
                pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
                title="Must contain at least one number, one uppercase, one lowercase, and one special character"
              />
            </div>
            <button type="submit">Login</button>
          </form>
          <hr />
          <div class="botones">
            <button>
              <img
                src="https://www.svgrepo.com/show/475656/google-color.svg"
                alt="Google logo"
              />
              Continue with Google
            </button>
            <button>
              <img
                src="https://www.svgrepo.com/show/475647/facebook-color.svg"
                alt="Facebook logo"
              />
              Continue with Facebook
            </button>
          </div>
        </div>
      </div>
      <div class="imagen">
        <img
          src="/images/cceac833.jpg"
          alt="Portal de Acceso"
        />
      </div>
    </div>
    <script src="/javascripts/login.js"></script>
  </body>
</html>
