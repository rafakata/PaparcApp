<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - PaparcApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Zen+Dots&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    />
    <link rel="stylesheet" href="/stylesheets/history.css" />
  </head>
  <body>
    <%- include('partials/nav_dashboard', { activeNav: 'history', user: user }) %>
    <div class="page-header py-4 mb-4">
      <div class="container-fluid px-4">
        <div class="row align-items-center">
          <div class="col-md-8">
            <h1 class="display-6 fw-bold text-dark mb-1">
              <i class="bi bi-clock-history text-primary me-2"></i><%= title %>
            </h1>
            <p class="text-muted mb-0">View and manage all bookings registered in the system</p>
          </div>
          <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="badge bg-light text-dark fs-6 px-3 py-2">
              <i class="bi bi-database me-2"></i><%= pagination.totalCount %> bookings
            </span>
          </div>
        </div>
      </div>
    </div>

    <main class="container-fluid px-4 pb-5">

      <div class="card border-0 shadow-sm mb-4 filter-card">
        <div class="card-body py-3">
          <form method="GET" action="/admin/history" class="row g-3 align-items-end">
            <div class="col-md-3">
              <label class="form-label fw-500"><i class="bi bi-search me-1"></i>Search</label>
              <input type="text" class="form-control" name="search" placeholder="Name or license plate..." value="<%= filters.search %>">
            </div>
            <div class="col-md-2">
              <label class="form-label fw-500"><i class="bi bi-funnel me-1"></i>Status</label>
              <select class="form-select" name="status">
                <option value="">All</option>
                <option value="PENDIENTE" <%= filters.status === 'PENDIENTE' ? 'selected' : '' %>>Pending</option>
                <option value="EN CURSO" <%= filters.status === 'EN CURSO' ? 'selected' : '' %>>In Progress</option>
                <option value="FINALIZADA" <%= filters.status === 'FINALIZADA' ? 'selected' : '' %>>Finished</option>
                <option value="CANCELADA" <%= filters.status === 'CANCELADA' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label fw-500"><i class="bi bi-calendar-event me-1"></i>From</label>
              <input type="date" class="form-control" name="dateFrom" value="<%= filters.dateFrom %>">
            </div>
            <div class="col-md-2">
              <label class="form-label fw-500"><i class="bi bi-calendar-check me-1"></i>To</label>
              <input type="date" class="form-control" name="dateTo" value="<%= filters.dateTo %>">
            </div>
            <div class="col-md-3 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-filter me-1"></i>Filter
              </button>
              <a href="/admin/history" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-gradient-primary text-white border-0 py-3">
          <h5 class="mb-0 fw-semibold">
            <i class="bi bi-table me-2"></i>All Bookings
          </h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-light">
                <tr>
                  <th class="ps-4">ID</th>
                  <th>Booking Date</th>
                  <th>Customer</th>
                  <th>License Plate</th>
                  <th>Vehicle</th>
                  <th>Entry</th>
                  <th>Exit</th>
                  <th>Service</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th>Paid</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (reservations.length > 0) { %>
                  <% reservations.forEach(r => { %>
                    <%
                      // MODIFICACIÓN: Mapeo limpio solo con los 4 estados
                      const statusClasses = {
                        'PENDIENTE': 'badge-status-pendiente',
                        'EN CURSO': 'badge-status-encurso',
                        'FINALIZADA': 'badge-status-finalizada',
                        'CANCELADA': 'badge-status-cancelada'
                      };
                      const badgeClass = statusClasses[r.status] || 'badge-status-pendiente';
                      
                      const statusText = {
                        'PENDIENTE': 'Pending',
                        'EN CURSO': 'In Progress',
                        'FINALIZADA': 'Finished',
                        'CANCELADA': 'Cancelled'
                      }[r.status] || r.status;
                    %>
                    <tr class="<%= r.status === 'CANCELADA' ? 'row-cancelled' : '' %> <%= r.status === 'FINALIZADA' ? 'row-finished' : '' %>">
                      <td class="ps-4 fw-bold text-muted">#<%= r.id_reservation %></td>
                      <td>
                        <small class="text-muted">
                          <%= new Date(r.reservation_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                        </small>
                      </td>
                      <td>
                        <div class="fw-semibold"><%= r.customer_name %></div>
                        <small class="text-muted"><%= r.phone %></small>
                      </td>
                      <td>
                        <span class="license-plate"><%= r.license_plate %></span>
                      </td>
                      <td>
                        <small><%= r.brand %> <%= r.model %></small>
                        <% if (r.color) { %>
                          <br><small class="text-muted"><%= r.color %></small>
                        <% } %>
                      </td>
                      <td>
                        <div class="date-cell">
                          <span class="fw-semibold"><%= new Date(r.entry_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) %></span>
                          <small class="text-muted d-block"><%= new Date(r.entry_date).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></small>
                        </div>
                      </td>
                      <td>
                        <% if (r.exit_date) { %>
                          <div class="date-cell">
                            <span class="fw-semibold"><%= new Date(r.exit_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) %></span>
                            <small class="text-muted d-block"><%= new Date(r.exit_date).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></small>
                          </div>
                        <% } else { %>
                          <span class="text-muted">—</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= r.service_name %></span>
                      </td>
                      <td class="fw-bold"><%= parseFloat(r.total_price).toFixed(2) %> €</td>
                      <td>
                        <span class="badge-status <%= badgeClass %>"><%= statusText %></span>
                      </td>
                      <td>
                        <% if (r.is_paid) { %>
                          <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill me-1"></i>Yes</span>
                        <% } else { %>
                          <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle me-1"></i>No</span>
                        <% } %>
                      </td>
                      <td>
                        <a href="/admin/reservations/details/<%= r.id_reservation %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                          Manage <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="12" class="text-center py-5">
                      <div class="empty-state">
                        <i class="bi bi-inbox display-4 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">No bookings found with the selected filters</p>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <% if (pagination.totalPages > 1) { %>
          <div class="card-footer bg-white border-0 py-3">
            <nav>
              <ul class="pagination justify-content-center mb-0">
                <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="/admin/history?page=<%= pagination.page - 1 %>&status=<%= filters.status %>&search=<%= filters.search %>&dateFrom=<%= filters.dateFrom %>&dateTo=<%= filters.dateTo %>">
                    <i class="bi bi-chevron-left"></i>
                  </a>
                </li>
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                  <% if (i === 1 || i === pagination.totalPages || (i >= pagination.page - 2 && i <= pagination.page + 2)) { %>
                    <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                      <a class="page-link" href="/admin/history?page=<%= i %>&status=<%= filters.status %>&search=<%= filters.search %>&dateFrom=<%= filters.dateFrom %>&dateTo=<%= filters.dateTo %>"><%= i %></a>
                    </li>
                  <% } else if (i === pagination.page - 3 || i === pagination.page + 3) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="/admin/history?page=<%= pagination.page + 1 %>&status=<%= filters.status %>&search=<%= filters.search %>&dateFrom=<%= filters.dateFrom %>&dateTo=<%= filters.dateTo %>">
                    <i class="bi bi-chevron-right"></i>
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        <% } %>
      </div>

    </main>

    <%- include('partials/footer_dashboard') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>