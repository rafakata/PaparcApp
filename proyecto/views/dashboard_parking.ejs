<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Real-Time Parking - PaparcApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Zen+Dots&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    />
    <link rel="stylesheet" href="/stylesheets/dashboard.css" />
    <link rel="stylesheet" href="/stylesheets/parking.css" />
  </head>
  <body>
    <!-- Navbar -->
    <%- include('partials/nav_dashboard', { activeNav: 'parking', user: user }) %>
    <!-- Stats Summary Bar -->
    <div class="parking-stats-bar py-3">
      <div class="container-fluid px-4">
        <div class="row g-3 justify-content-center">
          <!-- Occupancy -->
          <div class="col-auto">
            <div class="parking-stat-pill stat-ocupacion">
              <div class="stat-pill-icon">
                <i class="bi bi-pie-chart-fill"></i>
              </div>
              <div class="stat-pill-content">
                <span class="stat-pill-label">OCCUPANCY</span>
                <span class="stat-pill-value" id="stat-ocupacion">0%</span>
                <span class="stat-pill-detail" id="stat-detail">0 Occupied · 0 Free</span>
              </div>
            </div>
          </div>
          <!-- Total Spots -->
          <div class="col-auto">
            <div class="parking-stat-pill stat-total">
              <div class="stat-pill-icon">
                <i class="bi bi-grid-3x3-gap-fill"></i>
              </div>
              <div class="stat-pill-content">
                <span class="stat-pill-label">TOTAL SPOTS</span>
                <span class="stat-pill-value" id="stat-total-spots">0</span>
              </div>
            </div>
          </div>
          <!-- Reserved -->
          <div class="col-auto">
            <div class="parking-stat-pill stat-reservadas">
              <div class="stat-pill-icon">
                <i class="bi bi-bookmark-fill"></i>
              </div>
              <div class="stat-pill-content">
                <span class="stat-pill-label">RESERVED</span>
                <span class="stat-pill-value" id="stat-reservadas">0</span>
              </div>
            </div>
          </div>
          <!-- In Progress -->
          <div class="col-auto">
            <div class="parking-stat-pill stat-encurso">
              <div class="stat-pill-icon">
                <i class="bi bi-car-front-fill"></i>
              </div>
              <div class="stat-pill-content">
                <span class="stat-pill-label">IN PROGRESS</span>
                <span class="stat-pill-value" id="stat-encurso">0</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main class="container-fluid px-4 pb-5 mt-4">
      <!-- Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
          <i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Parking Map
        </h4>
      </div>

      <!-- Status Legend -->
      <div class="status-legend-bar mb-4">
        <span class="legend-item">
          <span class="legend-dot libre"></span> Free
        </span>
        <span class="legend-item">
          <span class="legend-dot ocupado"></span> In Progress
        </span>
        <span class="legend-item">
          <span class="legend-dot reservado"></span> Reserved
        </span>
        <span class="legend-item">
          <span class="legend-dot no-disponible"></span> Not Available
        </span>
      </div>

      <!-- Parking grid (grouped by row) -->
      <div id="parking-grid">
        <!-- Spots will be loaded dynamically -->
        <div class="col-12 text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="text-muted mt-2">Loading parking spots...</p>
        </div>
      </div>
    </main>

    <!-- Template for FREE spot -->
    <template id="spot-template-libre">
      <div class="col-6 col-sm-4 col-md-3 col-xl-2 spot-col">
        <div class="parking-card parking-card-libre">
          <div class="parking-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-car-front-fill parking-card-icon"></i>
              <div>
                <span class="parking-card-code"></span>
                <span class="parking-card-type"></span>
              </div>
            </div>
            <span class="badge parking-badge badge-libre">FREE</span>
          </div>
          <div class="parking-card-body">
            <div class="parking-card-car-img">
              <i class="bi bi-car-front"></i>
            </div>
            <span class="parking-card-status-text text-success">Available</span>
          </div>
        </div>
      </div>
    </template>

    <!-- Template for OCCUPIED spot (IN PROGRESS) -->
    <template id="spot-template-ocupado">
      <div class="col-6 col-sm-4 col-md-3 col-xl-2 spot-col">
        <div class="parking-card parking-card-ocupado">
          <div class="parking-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-car-front-fill parking-card-icon"></i>
              <div>
                <span class="parking-card-code"></span>
                <span class="parking-card-type"></span>
              </div>
            </div>
            <span class="badge parking-badge badge-ocupado">OCCUPIED</span>
          </div>
          <div class="parking-card-body">
            <p class="parking-card-customer">
              <i class="bi bi-person-fill me-1"></i>
              <span class="customer-name"></span>
            </p>
            <div class="parking-card-plate">
              <i class="bi bi-credit-card-2-front me-1"></i>
              <span class="plate-text"></span>
            </div>
            <div class="parking-card-dates">
              <div class="date-block entry">
                <span class="date-label">ENTRY</span>
                <span class="date-value entry-date"></span>
              </div>
              <div class="date-block exit">
                <span class="date-label">EXIT</span>
                <span class="date-value exit-date"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </template>

    <!-- Template for RESERVED spot -->
    <template id="spot-template-reservado">
      <div class="col-6 col-sm-4 col-md-3 col-xl-2 spot-col">
        <div class="parking-card parking-card-reservado">
          <div class="parking-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-car-front-fill parking-card-icon"></i>
              <div>
                <span class="parking-card-code"></span>
                <span class="parking-card-type"></span>
              </div>
            </div>
            <span class="badge parking-badge badge-reservado">RESERVED</span>
          </div>
          <div class="parking-card-body">
            <p class="parking-card-customer">
              <i class="bi bi-person-fill me-1"></i>
              <span class="customer-name"></span>
            </p>
            <div class="parking-card-arrival">
              <i class="bi bi-clock-fill me-1"></i>
              <span class="date-label">ARRIVAL TIME</span>
              <span class="arrival-date"></span>
            </div>
          </div>
        </div>
      </div>
    </template>

    <!-- Template for NOT AVAILABLE spot -->
    <template id="spot-template-nodisponible">
      <div class="col-6 col-sm-4 col-md-3 col-xl-2 spot-col">
        <div class="parking-card parking-card-nodisponible">
          <div class="parking-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-car-front-fill parking-card-icon"></i>
              <div>
                <span class="parking-card-code"></span>
                <span class="parking-card-type"></span>
              </div>
            </div>
            <span class="badge parking-badge badge-nodisponible">NOT AVAILABLE</span>
          </div>
          <div class="parking-card-body">
            <div class="parking-card-car-img text-muted">
              <i class="bi bi-x-circle"></i>
            </div>
            <span class="parking-card-status-text text-muted">Not available</span>
          </div>
        </div>
      </div>
    </template>

    <footer>
      <%- include('partials/footer_dashboard') %>
    </footer>
  </body>
  
  <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/javascripts/parking.js"></script>
</html>
