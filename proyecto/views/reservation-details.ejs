<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PaparcApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/reservation-details.css">
</head>
<body>

    <%
        function formatForDateTimeLocal(dateInput) {
            if (!dateInput) return '';
            const d = new Date(dateInput);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            return d.toISOString().slice(0, 16);
        }

        const statusMap = {
            'PENDIENTE': { class: 'badge-pendiente', icon: 'bi-hourglass-split', label: 'Pending' },
            'EN CURSO': { class: 'badge-en-curso', icon: 'bi-play-circle', label: 'In Progress' },
            'FINALIZADA': { class: 'badge-finalizada', icon: 'bi-check-all', label: 'Finished' },
            'CANCELADA': { class: 'badge-cancelada', icon: 'bi-x-circle', label: 'Cancelled' }
        };
        const currentStatus = statusMap[reservation.status] || statusMap['PENDIENTE'];
    %>

 <%- include('partials/nav_dashboard', { activeNav: 'reservations', user: user }) %>
    <div class="page-header py-2 mb-2">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-2" style="font-size: 0.82rem;">
                            <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none" style="color: #667eea;">Dashboard</a></li>
                            <li class="breadcrumb-item active">Booking #<%= reservation.id_reservation %></li>
                        </ol>
                    </nav>
                    
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" id="btn_go_back" class="btn btn-outline-secondary btn-sm fw-medium px-3 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Go Back
                        </button>
                        
                        <div class="vr bg-secondary opacity-25" style="height: 24px; width: 2px;"></div>
                        
                        <h2 class="h5 fw-bold mb-0 text-dark">
                            <i class="bi bi-clipboard-data text-primary me-2"></i><%= title %>
                        </h2>
                    </div>

                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <span class="status-badge-pill <%= currentStatus.class %>">
                        <i class="bi <%= currentStatus.icon %> me-1"></i><%= currentStatus.label %>
                    </span>
                    <div class="text-muted mt-2" style="font-size: 0.8rem;">
                        <i class="bi bi-calendar3 me-1"></i>Created: <%= new Date(reservation.reservation_date).toLocaleString('en-GB', { dateStyle: 'short', timeStyle: 'short' }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <main class="container-fluid px-4 pb-3">
        <form id="editReservationForm" action="/admin/reservations/<%= reservation.id_reservation %>/edit" method="POST">
            <div class="row g-2"> 

                <div class="col-lg-8 d-flex flex-column gap-2"> 
                    
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="detail-card h-100 shadow-sm border-0">
                                <div class="card-header bg-gradient-primary text-white py-2"> 
                                    <i class="bi bi-person-vcard mb-0"></i> Customer Information
                                </div>
                                <div class="card-body p-3"> <div class="row g-2"> <div class="col-12">
                                            <label class="form-label small text-muted mb-1" for="customer_name">Full Name</label>
                                            <input type="text" class="form-control form-control-sm" id="customer_name" name="customer_name" value="<%= reservation.customer_name %>" required>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label small text-muted mb-1" for="phone">Phone</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone"></i></span>
                                                <input type="tel" class="form-control border-start-0" id="phone" name="phone" value="<%= reservation.phone %>" required>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label small text-muted mb-1" for="email">Email</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                                                <input type="email" class="form-control border-start-0" id="email" name="email" value="<%= reservation.email %>" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card h-100 shadow-sm border-0">
                                <div class="card-header bg-gradient-secondary text-white py-2">
                                    <i class="bi bi-car-front-fill"></i> Vehicle Information
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label small text-muted mb-1" for="license_plate">License Plate</label>
                                            <input type="text" class="form-control form-control-sm fw-bold bg-light" id="license_plate" name="license_plate" value="<%= reservation.license_plate %>" readonly title="You cannot edit the license plate of an existing booking">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="brand">Brand</label>
                                            <input type="text" class="form-control form-control-sm" id="brand" name="brand" value="<%= reservation.brand %>" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="model">Model</label>
                                            <input type="text" class="form-control form-control-sm" id="model" name="model" value="<%= reservation.model %>" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="color">Color</label>
                                            <input type="text" class="form-control form-control-sm" id="color" name="color" value="<%= reservation.color %>">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="calc_vehicle_type">Type</label>
                                            <select class="form-select form-select-sm" id="calc_vehicle_type" name="vehicle_type">
                                                <% vehicleTypes.forEach(v => { %>
                                                    <option value="<%= v.type %>" <%= reservation.type === v.type ? 'selected' : '' %>><%= v.type %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="detail-card shadow-sm border-0">
                        <div class="card-header text-white py-2" style="background: #c566ea;">
                            <i class="bi bi-calendar-range"></i> Stay and Services
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1" for="calc_entry_date">
                                        <i class="bi bi-box-arrow-in-right text-success me-1"></i>Entry Date
                                    </label>
                                    <input type="datetime-local" class="form-control form-control-sm" id="calc_entry_date" name="entry_date" value="<%= formatForDateTimeLocal(reservation.entry_date) %>" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1" for="calc_exit_date">
                                        <i class="bi bi-box-arrow-left text-danger me-1"></i>Exit Date
                                    </label>
                                    <input type="datetime-local" class="form-control form-control-sm" id="calc_exit_date" name="exit_date" value="<%= formatForDateTimeLocal(reservation.exit_date) %>" required>
                                </div>
                                <div class="col-12 mt-1">
                                    <label class="form-label small text-muted mb-1" for="calc_main_service">Main Service</label>
                                    <select class="form-select form-select-sm" id="calc_main_service" name="id_main_service">
                                        <% mainServices.forEach(ms => { %>
                                            <option value="<%= ms.id_main_service %>" <%= reservation.id_main_service === ms.id_main_service ? 'selected' : '' %>><%= ms.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-12 mt-1">
                                    <label class="form-label small text-muted mb-1">Additional Services (Extras)</label>
                                    <div class="row g-2" id="additional_services_container">
                                        <% additionalServices.forEach(extra => { %>
                                            <% const isChecked = reservation.additional_services && reservation.additional_services.some(ras => ras.id_additional_service === extra.id_additional_service); %>
                                            <div class="col-6 col-xl-4">
                                                <div class="extra-checkbox-card p-1 border rounded d-flex align-items-center gap-2 <%= isChecked ? 'checked' : '' %>" style="font-size: 0.85rem;">
                                                    <input class="form-check-input calc_extra_service m-0 ms-1" type="checkbox" name="additional_services" value="<%= extra.id_additional_service %>" id="extra_<%= extra.id_additional_service %>" <%= isChecked ? 'checked' : '' %>>
                                                    <label class="form-check-label flex-grow-1 text-truncate mb-0" for="extra_<%= extra.id_additional_service %>" style="cursor:pointer;" title="<%= extra.name %>">
                                                        <%= extra.name %>
                                                    </label>
                                                    <span class="extra-price me-1 fw-medium">+<%= extra.price %>€</span>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-2 border-top pt-2">
                        <label class="form-label small fw-bold text-dark mb-1" for="cod_parking_spot">
                            <i class="bi bi-p-square-fill text-primary me-1"></i>Parking Spot Assignment
                        </label>
                        <input type="text" class="form-control form-control-sm border-primary" id="cod_parking_spot" name="cod_parking_spot" value="<%= reservation.cod_parking_spot || '' %>" placeholder="e.g. A-15, Basement 2...">
                        <div class="form-text" style="font-size: 0.7rem;">
                            Type the spot where the vehicle is parked. It is mandatory for "In Progress" bookings.
                        </div>
                    </div>

                </div>

                <div class="col-lg-4">
                    <div class="sidebar-wrapper d-flex flex-column gap-2 sticky-lg-top" style="top: 80px;">
                    
                    <div class="price-card p-3 shadow-sm border-0">
                        <div class="position-relative" style="z-index:1;">
                            <h6 class="text-white-50 mb-1 small"><i class="bi bi-receipt me-1"></i> Total Calculated</h6>
                            <div class="d-flex align-items-baseline gap-1">
                                <span class="price-amount fs-2 fw-bold" id="dynamic_total_price"><%= reservation.total_price %></span>
                                <span class="price-currency fs-5">€</span>
                            </div>
                            <span id="recalculating_indicator" style="display:none; font-size: 0.8rem;">
                                <i class="bi bi-arrow-repeat"></i> Recalculating...
                            </span>
                        </div>
                        
                        <div class="d-grid gap-2 mt-3 pt-3 border-top border-light border-opacity-25">
                            <button type="submit" id="btn_save_changes" class="btn btn-save-main btn-sm py-2 shadow-sm btn-submit-dynamic">
                                <i class="bi bi-check-lg me-1"></i> Confirm Changes
                            </button>
                            
                            <hr class="my-1 border-secondary border-opacity-25">
                            
                            <% if (reservation.status === 'PENDIENTE') { %>
                                <button type="button" id="btn_start_reservation" class="btn btn-success btn-sm py-2 shadow-sm" 
                                        data-id="<%= reservation.id_reservation %>" 
                                        data-photos="<%= reservation.photos ? reservation.photos.length : 0 %>">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Receive Vehicle
                                </button>
                                
                                <button type="button" id="btn_delete_reservation" class="btn btn-danger btn-sm py-1 shadow-sm mt-2" data-id="<%= reservation.id_reservation %>">
                                    <i class="bi bi-trash3-fill me-1"></i> Cancel Booking
                                </button>
                            <% } %>

                            <% if (reservation.status === 'EN CURSO') { %>
                                <button type="button" id="btn_finalize_reservation" class="btn btn-danger btn-sm py-2 shadow-sm" data-id="<%= reservation.id_reservation %>">
                                    <i class="bi bi-flag-fill me-1"></i> Finalize and Check Out
                                </button>
                            <% } %>
                        </div>
                    </div>

                    <div class="detail-card shadow-sm border-0">
                        <div class="card-header text-white py-2" style="background: var(--gradient-warning);">
                            <i class="bi bi-camera"></i> Evidence
                        </div>
                        <div class="card-body p-3">
                            <% if (reservation.status === 'PENDIENTE') { %>
                                <div class="upload-alert mb-2 p-2 rounded bg-light border-start border-warning border-4" style="font-size: 0.8rem;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-exclamation-triangle text-warning me-1"></i> Min. 5 photos</span>
                                        <strong class="text-dark"><%= reservation.photos ? reservation.photos.length : 0 %>/5 uploaded</strong>
                                    </div>
                                </div>
                                <div class="upload-form d-flex mb-3 gap-1">
                                    <input type="url" class="form-control form-control-sm w-50" id="photo_url_input" placeholder="Photo URL...">
                                    <input type="text" class="form-control form-control-sm w-50" id="photo_desc_input" placeholder="Descripción (opcional)" maxlength="200">
                                    <button type="button" id="btn_upload_photo" class="btn btn-sm text-white" style="background: var(--gradient-primary);" data-id="<%= reservation.id_reservation %>">
                                        <i class="bi bi-upload"></i>
                                    </button>
                                </div>
                            <% } %>

                            <div class="row g-2">
                                <% if (reservation.photos && reservation.photos.length > 0) { %>
                                    <% reservation.photos.forEach((photo, index) => { %>
                                        <div class="col-12">
                                            <div class="photo-evidence-card p-2 border rounded bg-light d-flex justify-content-between align-items-center">
                                                <a href="<%= photo.file_path %>" target="_blank" class="text-truncate text-decoration-none" style="max-width: 150px; font-size: 0.85rem;" title="<%= photo.description || `Photo ${index + 1}` %>">
                                                    <i class="bi bi-image text-primary me-1"></i> <%= photo.description ? photo.description : `Photo ${index + 1}` %>
                                                </a>
                                                <span class="photo-date text-muted" style="font-size: 0.75rem;"><%= new Date(photo.taken_at).toLocaleDateString('en-GB') %></span>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12">
                                        <p class="text-muted fst-italic text-center mb-0 py-2" style="font-size: 0.85rem;">
                                            <i class="bi bi-camera-video-off me-1"></i>No evidence
                                        </p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="detail-card shadow-sm border-0">
                        <div class="card-header text-white py-2" style="background: var(--gradient-secondary);">
                            <i class="bi bi-bell"></i> Notifications
                        </div>
                        <div class="card-body p-0" style="max-height: 180px; overflow-y: auto;">
                            <% if (reservation.notifications && reservation.notifications.length > 0) { %>
                                <% reservation.notifications.forEach(notif => { %>
                                    <div class="notification-item p-2 border-bottom">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <span class="notification-type fw-medium text-dark" style="font-size: 0.8rem;"><i class="bi bi-send text-secondary me-1"></i><%= notif.type %></span>
                                            <span class="notification-date text-muted" style="font-size: 0.7rem;"><%= new Date(notif.sent_at).toLocaleDateString('en-GB') %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="p-3 text-center">
                                    <p class="text-muted fst-italic mb-0" style="font-size: 0.85rem;">
                                        <i class="bi bi-bell-slash me-1"></i>No notifications sent
                                    </p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    </div></div>

            </div>
        </form>
    </main>

    <%- include('partials/footer_dashboard') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/javascripts/dynamic-pricing.js"></script>

    <script src="/javascripts/flash-alert.js"></script>
    <script src="/javascripts/reservation-details-alert.js"></script>
</body>
</html>