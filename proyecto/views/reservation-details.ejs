<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PaparcApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/reservation-details.css">
</head>
<body>

    <%
        function formatForDateTimeLocal(dateInput) {
            if (!dateInput) return '';
            const d = new Date(dateInput);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            return d.toISOString().slice(0, 16);
        }

        const statusMap = {
            'PENDIENTE': { class: 'badge-pendiente', icon: 'bi-hourglass-split' },
            'CONFIRMADA': { class: 'badge-confirmada', icon: 'bi-check-circle' },
            'EN_CURSO': { class: 'badge-en-curso', icon: 'bi-play-circle' },
            'FINALIZADA': { class: 'badge-finalizada', icon: 'bi-check-all' },
            'CANCELADA': { class: 'badge-cancelada', icon: 'bi-x-circle' }
        };
        const currentStatus = statusMap[reservation.status] || statusMap['PENDIENTE'];
    %>

    <!-- Navbar (same as dashboard) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary sticky-top shadow-lg">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="/admin/dashboard">
                <i class="bi bi-p-circle-fill fs-3 me-2"></i>
                <span class="brand-text">PaparcApp</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/admin/dashboard">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/admin/dashboard/dashboard_booking">
                            <i class="bi bi-calendar-plus me-1"></i> Nueva Reserva
                        </a>
                    </li>
                                <li class="nav-item">
              <a class="nav-link px-3" href="/admin/history">
                <i class="bi bi-clock-history me-1"></i> Historial
              </a>
            </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/admin/dashboard/parking">
                            <i class="bi bi-car-front me-2"></i>Parking en Tiempo Real
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#" role="button" data-bs-toggle="dropdown">
                            <div class="avatar-circle me-2">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <span class="d-none d-md-inline"><%= user.nombre %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                            <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/users/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <div class="page-header py-2 mb-2">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1" style="font-size: 0.82rem;">
                            <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none" style="color: #667eea;">Dashboard</a></li>
                            <li class="breadcrumb-item active">Reserva #<%= reservation.id_reservation %></li>
                        </ol>
                    </nav>
                    <h2 class="h5 fw-bold mb-0">
                        <i class="bi bi-clipboard-data text-primary me-2"></i><%= title %>
                    </h2>
                </div>
                <div class="col-md-4 text-md-end mt-1 mt-md-0">
                    <span class="status-badge-pill <%= currentStatus.class %>">
                        <i class="bi <%= currentStatus.icon %> me-1"></i><%= reservation.status %>
                    </span>
                    <div class="text-muted mt-1" style="font-size: 0.8rem;">
                        <i class="bi bi-calendar3 me-1"></i>Creada: <%= new Date(reservation.reservation_date).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="container-fluid px-4 pb-3">
        <form id="editReservationForm" action="/admin/reservations/<%= reservation.id_reservation %>/edit" method="POST">
            <div class="row g-2"> 

                <div class="col-lg-8 d-flex flex-column gap-2"> 
                    
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="detail-card h-100 shadow-sm border-0">
                                <div class="card-header bg-gradient-primary text-white py-2"> 
                                    <i class="bi bi-person-vcard mb-0"></i> Información del Cliente
                                </div>
                                <div class="card-body p-3"> <div class="row g-2"> <div class="col-12">
                                            <label class="form-label small text-muted mb-1" for="customer_name">Nombre Completo</label>
                                            <input type="text" class="form-control form-control-sm" id="customer_name" name="customer_name" value="<%= reservation.customer_name %>" required>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label small text-muted mb-1" for="phone">Teléfono</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone"></i></span>
                                                <input type="tel" class="form-control border-start-0" id="phone" name="phone" value="<%= reservation.phone %>" required>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label small text-muted mb-1" for="email">Correo</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                                                <input type="email" class="form-control border-start-0" id="email" name="email" value="<%= reservation.email %>" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card h-100 shadow-sm border-0">
                                <div class="card-header bg-gradient-secondary text-white py-2">
                                    <i class="bi bi-car-front-fill"></i> Información del Vehículo
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label small text-muted mb-1" for="license_plate">Matrícula</label>
                                            <input type="text" class="form-control form-control-sm fw-bold" id="license_plate" name="license_plate" value="<%= reservation.license_plate %>" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="brand">Marca</label>
                                            <input type="text" class="form-control form-control-sm" id="brand" name="brand" value="<%= reservation.brand %>" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="model">Modelo</label>
                                            <input type="text" class="form-control form-control-sm" id="model" name="model" value="<%= reservation.model %>" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="color">Color</label>
                                            <input type="text" class="form-control form-control-sm" id="color" name="color" value="<%= reservation.color %>">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="calc_vehicle_type">Tipo</label>
                                            <select class="form-select form-select-sm" id="calc_vehicle_type" name="vehicle_type">
                                                <% vehicleTypes.forEach(v => { %>
                                                    <option value="<%= v.type %>" <%= reservation.type === v.type ? 'selected' : '' %>><%= v.type %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="detail-card shadow-sm border-0">
                        <div class="card-header text-white py-2" style="background: var(--gradient-success);">
                            <i class="bi bi-calendar-range"></i> Estancia y Servicios
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1" for="calc_entry_date">
                                        <i class="bi bi-box-arrow-in-right text-success me-1"></i>Fecha de Entrada
                                    </label>
                                    <input type="datetime-local" class="form-control form-control-sm" id="calc_entry_date" name="entry_date" value="<%= formatForDateTimeLocal(reservation.entry_date) %>" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1" for="calc_exit_date">
                                        <i class="bi bi-box-arrow-left text-danger me-1"></i>Fecha de Salida
                                    </label>
                                    <input type="datetime-local" class="form-control form-control-sm" id="calc_exit_date" name="exit_date" value="<%= formatForDateTimeLocal(reservation.exit_date) %>" required>
                                </div>
                                <div class="col-12 mt-1">
                                    <label class="form-label small text-muted mb-1" for="calc_main_service">Servicio Principal</label>
                                    <select class="form-select form-select-sm" id="calc_main_service" name="id_main_service">
                                        <% mainServices.forEach(ms => { %>
                                            <option value="<%= ms.id_main_service %>" <%= reservation.id_main_service === ms.id_main_service ? 'selected' : '' %>><%= ms.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-12 mt-1">
                                    <label class="form-label small text-muted mb-1">Servicios Adicionales (Extras)</label>
                                    <div class="row g-2" id="additional_services_container">
                                        <% additionalServices.forEach(extra => { %>
                                            <% const isChecked = reservation.additional_services && reservation.additional_services.some(ras => ras.id_additional_service === extra.id_additional_service); %>
                                            <div class="col-6 col-xl-4">
                                                <div class="extra-checkbox-card p-1 border rounded d-flex align-items-center gap-2 <%= isChecked ? 'checked' : '' %>" style="font-size: 0.85rem;">
                                                    <input class="form-check-input calc_extra_service m-0 ms-1" type="checkbox" name="additional_services" value="<%= extra.id_additional_service %>" id="extra_<%= extra.id_additional_service %>" <%= isChecked ? 'checked' : '' %>>
                                                    <label class="form-check-label flex-grow-1 text-truncate mb-0" for="extra_<%= extra.id_additional_service %>" style="cursor:pointer;" title="<%= extra.name %>">
                                                        <%= extra.name %>
                                                    </label>
                                                    <span class="extra-price me-1 fw-medium">+<%= extra.price %>€</span>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-lg-4">
                    <div class="sidebar-wrapper d-flex flex-column gap-2 sticky-lg-top" style="top: 80px;">
                    
                    <div class="price-card p-3 shadow-sm border-0">
                        <div class="position-relative" style="z-index:1;">
                            <h6 class="text-white-50 mb-1 small"><i class="bi bi-receipt me-1"></i> Total Calculado</h6>
                            <div class="d-flex align-items-baseline gap-1">
                                <span class="price-amount fs-2 fw-bold" id="dynamic_total_price"><%= reservation.total_price %></span>
                                <span class="price-currency fs-5">€</span>
                            </div>
                            <span id="recalculating_indicator" style="display:none; font-size: 0.8rem;">
                                <i class="bi bi-arrow-repeat"></i> Recalculando...
                            </span>
                        </div>
                        
                        <div class="d-grid gap-2 mt-3 pt-3 border-top border-light border-opacity-25">
                            <button type="submit" id="btn_save_changes" class="btn btn-save-main btn-sm py-2 shadow-sm btn-submit-dynamic">
                                <i class="bi bi-check-lg me-1"></i> Confirmar y Guardar
                            </button>
                            <button type="button" id="btn_cancel_changes" class="btn btn-cancel-main btn-sm py-1">
                                <i class="bi bi-x-lg me-1"></i> Descartar Cambios
                            </button>
                        </div>
                    </div>

                    <div class="detail-card shadow-sm border-0">
                        <div class="card-header text-white py-2" style="background: var(--gradient-warning);">
                            <i class="bi bi-camera"></i> Evidencias
                        </div>
                        <div class="card-body p-3">
                            <% if (reservation.status === 'PENDIENTE' || reservation.status === 'CONFIRMADA') { %>
                                <div class="upload-alert mb-2 p-2 rounded bg-light border-start border-warning border-4" style="font-size: 0.8rem;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-exclamation-triangle text-warning me-1"></i> Mín. 5 fotos</span>
                                        <strong class="text-dark"><%= reservation.photos ? reservation.photos.length : 0 %>/5 subidas</strong>
                                    </div>
                                </div>
                                <form action="/admin/reservations/<%= reservation.id_reservation %>/photos" method="POST" class="upload-form d-flex mb-3 gap-1">
                                    <input type="url" class="form-control form-control-sm" name="file_path" placeholder="URL de la foto..." required>
                                    <button type="submit" class="btn btn-sm text-white" style="background: var(--gradient-primary);">
                                        <i class="bi bi-upload"></i>
                                    </button>
                                </form>
                            <% } %>

                            <div class="row g-2">
                                <% if (reservation.photos && reservation.photos.length > 0) { %>
                                    <% reservation.photos.forEach((photo, index) => { %>
                                        <div class="col-12">
                                            <div class="photo-evidence-card p-2 border rounded bg-light d-flex justify-content-between align-items-center">
                                                <a href="<%= photo.file_path %>" target="_blank" class="text-truncate text-decoration-none" style="max-width: 150px; font-size: 0.85rem;"><i class="bi bi-image text-primary me-1"></i> Foto <%= index + 1 %></a>
                                                <span class="photo-date text-muted" style="font-size: 0.75rem;"><%= new Date(photo.taken_at).toLocaleDateString('es-ES') %></span>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12">
                                        <p class="text-muted fst-italic text-center mb-0 py-2" style="font-size: 0.85rem;">
                                            <i class="bi bi-camera-video-off me-1"></i>Sin evidencias
                                        </p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="detail-card shadow-sm border-0">
                        <div class="card-header text-white py-2" style="background: var(--gradient-secondary);">
                            <i class="bi bi-bell"></i> Avisos
                        </div>
                        <div class="card-body p-0" style="max-height: 180px; overflow-y: auto;">
                            <% if (reservation.notifications && reservation.notifications.length > 0) { %>
                                <% reservation.notifications.forEach(notif => { %>
                                    <div class="notification-item p-2 border-bottom">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <span class="notification-type fw-medium text-dark" style="font-size: 0.8rem;"><i class="bi bi-send text-secondary me-1"></i><%= notif.type %></span>
                                            <span class="notification-date text-muted" style="font-size: 0.7rem;"><%= new Date(notif.sent_at).toLocaleDateString('es-ES') %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="p-3 text-center">
                                    <p class="text-muted fst-italic mb-0" style="font-size: 0.85rem;">
                                        <i class="bi bi-bell-slash me-1"></i>Sin avisos enviados
                                    </p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    </div><!-- /sidebar-wrapper -->

                </div>

            </div>
        </form>
    </main>

    <%- include('partials/footer_dashboard') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/javascripts/dynamic-pricing.js"></script>

    <script src="/javascripts/flash-alert.js"></script>
    <script src="/javascripts/reservation-details-alert.js"></script>
</body>
</html>
