      <div class="hero">
        <h1>Tu parking de confianza en <span>PaparcApp</span></h1>
        <p class="sub_titulo">
          Máxima comodidad y seguridad para cuidar de tu vehículo
        </p>
        <div class="contenedor_reserva">
          <div class="reserva">
            <!-- Entrada -->
            <label for="entrada"> <i class="fas fa-car"></i> Entrance </label>
            <input type="datetime-local" id="entrada" />

            <!-- Salida -->
            <label for="salida"> <i class="fas fa-car-side"></i> Exit </label>
            <input type="datetime-local" id="salida" />

            <button id="reserva_boton">Search</button>
          </div>
        </div>
      </div>
    </header>
