<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - PaparcApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Zen+Dots&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    />
    <link
      rel="stylesheet"
      href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css"
    />
    <link rel="stylesheet" href="/stylesheets/dashboard.css" />
  </head>
  <body>
    <!-- Modern Navbar -->
    <nav
      class="navbar navbar-expand-lg navbar-dark bg-gradient-primary sticky-top shadow-lg"
    >
      <div class="container-fluid px-4">
        <a
          class="navbar-brand d-flex align-items-center"
          href="/admin/dashboard"
        >
          <span class="brand-text">PaparcApp</span>
        </a>
        <button
          class="navbar-toggler border-0"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link active px-3" href="/dashboard">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a
                class="nav-link px-3"
                href="/admin/dashboard/dashboard_booking"
              >
                <i class="bi bi-calendar-plus me-1"></i> New Booking
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link px-3" href="/admin/history">
                <i class="bi bi-clock-history me-1"></i> History
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link px-3" href="/admin/dashboard/parking">
                <i class="bi bi-car-front me-2"></i>Real-Time Parking
              </a>
            </li>
          </ul>
          <div class="d-flex align-items-center">
            <div class="dropdown">
              <a
                class="nav-link dropdown-toggle d-flex align-items-center text-white"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
              >
                <div class="avatar-circle me-2">
                  <i class="bi bi-person-fill"></i>
                </div>
                <span class="d-none d-md-inline"><%= user.nombre %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                <li>
                  <a class="dropdown-item" href="/profile"
                    ><i class="bi bi-person me-2"></i>My Profile</a
                  >
                </li>
                <!-- <li><a class="dropdown-item" href="/account"><i class="bi bi-gear me-2"></i>Configuración</a></li> -->
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <a class="dropdown-item text-danger" href="/users/logout"
                    ><i class="bi bi-box-arrow-right me-2"></i>Log Out</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Welcome Header -->
    <div class="welcome-header py-4 mb-4">
      <div class="container-fluid px-4">
        <div class="row align-items-center">
          <div class="col-md-8">
            <h1 class="display-6 fw-bold text-dark mb-1">
              <i class="bi bi-hand-wave text-warning me-2"></i>Hello, <%=
              user.nombre %>!
            </h1>
            <p class="text-muted mb-0">
              Welcome to your parking dashboard
            </p>
          </div>
          <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span
              class="badge bg-light text-dark fs-6 px-3 py-2"
              id="current-date-display"
            >
              <i class="bi bi-calendar3 me-2"></i>Loading date...
            </span>
          </div>
        </div>
      </div>
    </div>
    <!-- Main Content -->
    <main class="container-fluid px-4 pb-5">
      <!-- Stats Cards Row -->
      <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card stat-card-success">
            <div class="stat-icon">
              <i class="bi bi-box-arrow-in-right"></i>
            </div>
            <div class="stat-content">
              <h3 class="stat-number" id="stat-entries">0</h3>
              <p class="stat-label">Scheduled Entries</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card stat-card-danger">
            <div class="stat-icon"><i class="bi bi-box-arrow-left"></i></div>
            <div class="stat-content">
              <h3 class="stat-number" id="stat-exits">0</h3>
              <p class="stat-label">Scheduled Exits</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card stat-card-primary">
            <div class="stat-icon"><i class="bi bi-building-fill"></i></div>
            <div class="stat-content">
              <h3 class="stat-number" id="stat-total">-</h3>
              <p class="stat-label">Total Scheduled Bookings</p>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-xl-8">
          <div class="card border-0 shadow-sm mb-4">
            <div
              class="card-header bg-gradient-primary text-white border-0 py-3"
            >
              <h5 class="mb-0 fw-semibold">
                <i class="bi bi-car-front me-2"></i>Entries (Check-in)
              </h5>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="bg-light">
                    <tr>
                      <th class="ps-4">Time</th>
                      <th>License Plate</th>
                      <th>Brand</th>
                      <th>Color</th>
                      <th>Customer</th>
                      <th>Phone</th>
                      <th>Service</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody id="entries-table-body">
                    <tr>
                      <td colspan="8" class="text-center py-4">
                        Loading data...
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm">
            <div
              class="card-header bg-gradient-secondary text-white border-0 py-3"
            >
              <h5 class="mb-0 fw-semibold">
                <i class="bi bi-flag me-2"></i>Exits (Check-out)
              </h5>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="bg-light">
                    <tr>
                      <th class="ps-4">Time</th>
                      <th>License Plate</th>
                      <th>Brand</th>
                      <th>Color</th>
                      <th>Customer</th>
                      <th>Phone</th>
                      <th>Service</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody id="exits-table-body">
                    <tr>
                      <td colspan="8" class="text-center py-4">
                        Loading data...
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-xl-4">
          <div class="card border-0 shadow-sm mb-4">
            <div
              class="card-header bg-gradient-success text-white border-0 py-3"
            >
              <h5 class="mb-0 fw-semibold">
                <i class="bi bi-calendar3 me-2"></i>Calendar
              </h5>
            </div>
            <div
              class="card-body d-flex justify-content-center py-4 flex-column align-items-center"
            >
              <div class="calendario_widget"></div>

              <input type="hidden" id="date-picker" />
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Plantilla para filas de reservas -->
    <template id="row-template">
      <tr>
        <td class="column-time fw-bold text-muted ps-4"></td>
        <td class="column-license fw-bold"></td>
        <td class="column-brand text-muted"></td>
        <td class="column-color text-muted"></td>
        <td class="column-customer"></td>
        <td class="column-phone small"></td>
        <td>
          <span class="badge bg-light text-dark border column-service"></span>
        </td>
        <td>
          <a
            href="#"
            class="btn btn-sm btn-outline-primary rounded-pill px-3 column-btn"
          >
            Manage <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </td>
      </tr>
    </template>

    <%- include('partials/footer_dashboard') %>
  </body>
  <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>

  <script src="/javascripts/dashboard.js"></script>
</html>
