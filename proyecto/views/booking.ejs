<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Parking Reservation</title>
    <link rel="stylesheet" href="/stylesheets/booking.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Zen+Dots&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- NAVBAR -->
    <header>
        <%- include("partials/nav") %>
    </header>
    <main class="main-reserva">
      <div class="reserva-form-container">
        <div class="columna-izquierda">
          <form id="carForm" class="car-form">
            <h2>Datos del Vehículo</h2>
            <div class="form-group">
              <label for="nombre">Nombre</label>
              <input type="text" placeholder="Nombre y Apellidos" required/>
              <label for="telefono">Teléfono</label>
              <input type="text" placeholder="+XX XXXXXXXXXX" required/>
              <label for="matricula">Matrícula</label>
              <input
                type="text"
                id="matricula"
                name="matricula"
                required
                placeholder="0000-XXX"
              />
            </div>
            <div class="form-group">
              <label for="marca">Marca</label>
              <input type="text" id="marca" name="marca" placeholder="Marca del coche" required />
            </div>
            <div class="form-group">
              <label for="modelo">Modelo</label>
              <input type="text" id="modelo" name="modelo" placeholder="Modelo del coche" required />
            </div>
            <input type="hidden" id="entrada" name="entrada" />
            <input type="hidden" id="salida" name="salida" />
            <button type="submit">Confirmar Reserva</button>
          </form>
          <div id="confirmacion-reserva" class="confirmacion-reserva" style="display:none;">
            <h2>¡Reserva confirmada!</h2>
            <p>Código de reserva: <span id="codigo-reserva"></span></p>
            <div id="qr-reserva" class="qr-reserva"></div>
            <div class="datos-cliente">
              <h3>Datos del cliente</h3>
              <p><strong>Nombre:</strong> <span id="conf-nombre"></span></p>
              <p><strong>Teléfono:</strong> <span id="conf-telefono"></span></p>
              <p><strong>Matrícula:</strong> <span id="conf-matricula"></span></p>
              <p><strong>Marca:</strong> <span id="conf-marca"></span></p>
              <p><strong>Modelo:</strong> <span id="conf-modelo"></span></p>
            </div>
          </div>
          </form>
        </div>
        <div class="columna-central">
          <div class="contenedor-imagen-precio">
            <div class="imagen-coche">
              <img loading="lazy"
                src="/images/vecteezy_a-black-car-on-a-transparent-background_53016763.png"
                alt="Coche estacionado"
              />
            </div>
          </div>
        </div>
      </div>
      <div class="columna-derecha">
        <div class="datos-fechas">
          <h3>Datos de la Reserva</h3>
          <p><strong>Ida:</strong> <span id="fecha-ida"></span></p>
          <p><strong>Vuelta:</strong> <span id="fecha-vuelta"></span></p>
          <div class="precio-estancia">
            <h4>Precio:</h4>
            <div id="precio"></div>
            <h6>Iva incluido</h6>
          </div>
        </div>
      </div>
    </main>
    <!-- FOOTER -->
    <%- include("partials/footer") %>
    <script src="/javascripts/booking.js"></script>
  </body>
</html>
