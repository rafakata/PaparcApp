<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reserva | PaparcApp</title>
    <link rel="stylesheet" href="/stylesheets/booking.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900&family=Zen+Dots&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
  </head>
  <body>
    <!-- NAVBAR -->
    <header>
      <%- include("partials/nav") %>
    </header>

    <main class="booking-main">
      <div class="booking-card">
        <!-- Header -->
        <div class="booking-card-header">
          <h1>Reserva tu Plaza</h1>
          <p>Completa los pasos para asegurar tu aparcamiento</p>
        </div>

        <!-- Steps indicator -->
        <div class="booking-steps">
          <div class="step active" id="step-ind-1"><span>1</span> Fechas</div>
          <div class="step-line"></div>
          <div class="step" id="step-ind-2"><span>2</span> Vehículo</div>
          <div class="step-line"></div>
          <div class="step" id="step-ind-3"><span>3</span> Confirmar</div>
        </div>

        <!-- Step 1: Fechas -->
        <div class="booking-body" id="booking-step-1">
          <div class="form-row">
            <div class="form-group">
              <label for="book-entrada"><i class="fas fa-plane-departure"></i> Fecha de Entrada</label>
              <input type="datetime-local" id="book-entrada" name="entrada" required />
            </div>
            <div class="form-group">
              <label for="book-salida"><i class="fas fa-plane-arrival"></i> Fecha de Salida</label>
              <input type="datetime-local" id="book-salida" name="salida" required />
            </div>
          </div>
          <div class="booking-price-preview" id="booking-price-preview">
            <i class="fas fa-tag"></i> <span>Selecciona las fechas para ver el precio</span>
          </div>
          <div class="booking-actions">
            <a href="/" class="btn btn-cancel"><i class="fas fa-home"></i> Volver</a>
            <button type="button" class="btn btn-next" onclick="goToStep(2)"><i class="fas fa-arrow-right"></i> Siguiente</button>
          </div>
        </div>

        <!-- Step 2: Vehículo -->
        <div class="booking-body" id="booking-step-2" style="display: none;">
          <div class="form-row">
            <div class="form-group">
              <label for="book-nombre"><i class="fas fa-user"></i> Nombre completo</label>
              <input type="text" id="book-nombre" name="nombre" placeholder="Nombre y Apellidos" required />
            </div>
            <div class="form-group">
              <label for="book-telefono"><i class="fas fa-phone"></i> Teléfono</label>
              <input type="tel" id="book-telefono" name="telefono" placeholder="+34 600 123 456" required />
            </div>
          </div>
          <div class="form-group">
            <label for="book-matricula"><i class="fas fa-id-badge"></i> Matrícula</label>
            <input type="text" id="book-matricula" name="matricula" placeholder="0000-XXX" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="book-marca"><i class="fas fa-car"></i> Marca</label>
              <input type="text" id="book-marca" name="marca" placeholder="Marca del coche" required />
            </div>
            <div class="form-group">
              <label for="book-modelo"><i class="fas fa-car-side"></i> Modelo</label>
              <input type="text" id="book-modelo" name="modelo" placeholder="Modelo del coche" required />
            </div>
          </div>
          <div class="booking-actions">
            <button type="button" class="btn btn-cancel" onclick="goToStep(1)"><i class="fas fa-arrow-left"></i> Atrás</button>
            <button type="button" class="btn btn-next" onclick="goToStep(3)"><i class="fas fa-arrow-right"></i> Siguiente</button>
          </div>
        </div>

        <!-- Step 3: Confirmación -->
        <div class="booking-body" id="booking-step-3" style="display: none;">
          <div class="booking-summary">
            <h3><i class="fas fa-clipboard-check"></i> Resumen de tu Reserva</h3>
            <div class="summary-grid">
              <div class="summary-item">
                <i class="fas fa-plane-departure"></i>
                <div><strong>Entrada</strong><span id="sum-entrada">-</span></div>
              </div>
              <div class="summary-item">
                <i class="fas fa-plane-arrival"></i>
                <div><strong>Salida</strong><span id="sum-salida">-</span></div>
              </div>
              <div class="summary-item">
                <i class="fas fa-user"></i>
                <div><strong>Cliente</strong><span id="sum-nombre">-</span></div>
              </div>
              <div class="summary-item">
                <i class="fas fa-id-badge"></i>
                <div><strong>Matrícula</strong><span id="sum-matricula">-</span></div>
              </div>
              <div class="summary-item">
                <i class="fas fa-car"></i>
                <div><strong>Vehículo</strong><span id="sum-vehiculo">-</span></div>
              </div>
              <div class="summary-item">
                <i class="fas fa-phone"></i>
                <div><strong>Teléfono</strong><span id="sum-telefono">-</span></div>
              </div>
            </div>
            <div class="summary-price">
              <i class="fas fa-euro-sign"></i>
              <span id="sum-precio">0.00 €</span>
            </div>
          </div>
          <div class="booking-actions">
            <button type="button" class="btn btn-cancel" onclick="goToStep(2)"><i class="fas fa-arrow-left"></i> Atrás</button>
            <button type="button" class="btn btn-confirm" onclick="confirmBooking()"><i class="fas fa-check"></i> Confirmar Reserva</button>
          </div>
        </div>

        <!-- Step 4: Confirmación exitosa (oculto) -->
        <div class="booking-body" id="booking-step-success" style="display: none;">
          <div class="booking-success">
            <div class="success-icon">
              <i class="fas fa-check-circle"></i>
            </div>
            <h2>¡Reserva Confirmada!</h2>
            <p>Tu código de reserva es:</p>
            <div class="codigo-reserva" id="codigo-reserva"></div>
            <div id="qr-reserva" class="qr-reserva"></div>
            <div class="success-details">
              <p><i class="fas fa-user"></i> <span id="conf-nombre"></span></p>
              <p><i class="fas fa-phone"></i> <span id="conf-telefono"></span></p>
              <p><i class="fas fa-id-badge"></i> <span id="conf-matricula"></span></p>
              <p><i class="fas fa-car"></i> <span id="conf-vehiculo"></span></p>
            </div>
            <div class="booking-actions">
              <a href="/" class="btn btn-cancel"><i class="fas fa-home"></i> Ir al Inicio</a>
              <a href="/users/profile" class="btn btn-next"><i class="fas fa-user"></i> Mi Perfil</a>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>
    <script src="/javascripts/booking.js"></script>
  </body>
</html>
