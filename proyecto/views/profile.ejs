<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Account | PaparcApp</title>
    <link rel="stylesheet" href="/stylesheets/reserva.css" />
    <link rel="stylesheet" href="/stylesheets/profile.css" />
    <link rel="stylesheet" href="/stylesheets/nav-responsive.css" />
    <link rel="stylesheet" href="/stylesheets/booking.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900&family=Zen+Dots&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
  </head>
  <body>
    <header>
        <%- include("partials/nav") %>
    </header>
    <main class="profile-main">
      <div class="profile-container">
        <section class="profile-panel user-reserva-panel">
          <div class="panel-header">
            <i class="fas fa-user-circle"></i>
            <h2>My Account</h2>
          </div>
          <div class="user-info">
            <p><strong>Name:</strong> <span id="display-nombre"><%= locals.user ? user.nombre : 'User' %></span></p>
            <p><strong>Email:</strong> <span id="display-email"><%= locals.user ? user.email : '' %></span></p>
            <p><strong>Phone:</strong> <span id="display-telefono"><%= locals.user ? user.numero : '' %></span></p>
            <button class="btn btn-edit-profile" id="btn-open-edit-modal">
              <i class="fas fa-pen"></i> Edit Data
            </button>
          </div>

          <div class="reserva-actual">
            <h3><i class="fas fa-calendar-check"></i> Current Bookings</h3>
            
            <div class="historial-lista" style="max-height: 250px;">
              <% if (locals.activeReservations && activeReservations.length > 0) { %>
                <% activeReservations.forEach(function(resActual) { %>
                  <div class="historial-item reserva-clickable" style="cursor: pointer; position: relative;"
                       data-id="<%= resActual.id_reservation %>"
                       data-status="<%= resActual.status %>"
                       data-entry="<%= new Date(resActual.entry_date).toLocaleString('es-ES') %>"
                       data-exit="<%= resActual.exit_date ? new Date(resActual.exit_date).toLocaleString('es-ES') : 'No definida' %>"
                       data-entry-iso="<%= new Date(resActual.entry_date).toISOString() %>"
                       data-exit-iso="<%= resActual.exit_date ? new Date(resActual.exit_date).toISOString() : '' %>"
                       data-service="<%= resActual.main_service_name %>"
                       data-id-service="<%= resActual.id_main_service %>"
                       data-extras='<%= JSON.stringify(resActual.extra_services || []) %>'
                       data-vehicle="<%= resActual.license_plate %> (<%= resActual.brand %>)"
                       data-price="<%= parseFloat(resActual.total_price).toFixed(2) %>">
                    
                    <div class="historial-fecha">
                      <i class="fas fa-ticket-alt"></i>
                      <span>#<%= resActual.id_reservation %></span>
                    </div>
                    <div class="historial-servicio">
                      <i class="fas fa-calendar-day"></i>
                      <span><%= new Date(resActual.entry_date).toLocaleDateString('es-ES') %></span>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 5px;">
                      <strong style="font-size: 1.1rem; color: #333;"><%= parseFloat(resActual.total_price).toFixed(2) %> €</strong>
                      <span class="badge badge-<%= resActual.status.toLowerCase() %>"><%= resActual.status %></span>
                    </div>

                  </div>
                <% }) %>
              <% } else { %>
                <div class="no-reserva">
                  <i class="fas fa-info-circle"></i>
                  <p>You have no active bookings.</p>
                  <a href="/booking" class="btn btn-primary" style="display: inline-block; text-decoration: none;">Make a Booking</a>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <section class="profile-panel historial-panel">
          <div class="car-image-container">
            <img loading="lazy" src="/images/photo-1492144534655-ae79c964c9d7.avif" alt="Tu vehículo" class="car-image" />
          </div>

          <div class="panel-header">
            <i class="fas fa-history"></i>
            <h2>Booking History</h2>
          </div>
          <div class="historial-lista">
            <% if (locals.historyReservations && historyReservations.length > 0) { %>
              <% historyReservations.forEach(function(item) { %>
                <div class="historial-item reserva-clickable" style="cursor: pointer;"
                     data-id="<%= item.id_reservation %>"
                     data-status="<%= item.status %>"
                     data-entry="<%= new Date(item.entry_date).toLocaleString('es-ES') %>"
                     data-exit="<%= item.exit_date ? new Date(item.exit_date).toLocaleString('es-ES') : 'No definida' %>"
                     data-entry-iso="<%= new Date(item.entry_date).toISOString() %>"
                     data-exit-iso="<%= item.exit_date ? new Date(item.exit_date).toISOString() : '' %>"
                     data-service="<%= item.main_service_name %>"
                     data-id-service="<%= item.id_main_service %>"
                     data-extras='<%= JSON.stringify(item.extra_services || []) %>'
                     data-vehicle="<%= item.license_plate %> (<%= item.brand %>)"
                     data-price="<%= parseFloat(item.total_price).toFixed(2) %>">
                     
                  <div class="historial-fecha">
                    <i class="fas fa-calendar-alt"></i>
                    <span><%= new Date(item.entry_date).toLocaleDateString('es-ES') %></span>
                  </div>
                  <div class="historial-servicio">
                    <i class="fas fa-car"></i>
                    <span><%= item.license_plate %></span>
                  </div>
                  <div class="historial-precio">
                    <strong><%= parseFloat(item.total_price).toFixed(2) %> €</strong>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="no-historial">
                <i class="fas fa-folder-open"></i>
                <p>No previous bookings.</p>
              </div>
            <% } %>
          </div>
        </section>
      </div>
    </main>

    <%- include("partials/footer") %>

    <!-- Modal para editar datos personales y contraseña -->
    <div class="modal-overlay" id="editModal">
      <div class="modal-container">
        <div class="modal-header">
          <h2><i class="fas fa-user-edit"></i> Edit Profile</h2>
          <button class="modal-close" id="btn-close-edit-modal">
            <i class="fas fa-times"></i>
          </button>
        </div>

        <div class="modal-tabs">
          <button class="modal-tab active" data-target="form-datos" id="tab-datos">
            <i class="fas fa-id-card"></i> Personal Data
          </button>
          <button class="modal-tab" data-target="form-password" id="tab-password">
            <i class="fas fa-lock"></i> Password
          </button>
        </div>

        <form class="modal-body" id="form-datos">
          <div class="form-group">
            <label for="edit-nombre"><i class="fas fa-user"></i> Name</label>
            <input type="text" id="edit-nombre" name="nombre" value="<%= locals.user ? user.nombre : '' %>" required />
          </div>
          <div class="form-group">
            <label for="edit-email"><i class="fas fa-envelope"></i> Email</label>
            <input type="email" id="edit-email" name="email" value="<%= locals.user ? user.email : '' %>" required />
          </div>
          <div class="form-group">
            <label for="edit-telefono"><i class="fas fa-phone"></i> Phone</label>
            <input type="tel" id="edit-telefono" name="telefono" value="<%= locals.user ? user.numero : '' %>" required />
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-cancel cancel-edit-btn">Cancel</button>
            <button type="submit" class="btn btn-save"><i class="fas fa-save"></i> Save Changes</button>
          </div>
        </form>

        <form class="modal-body" id="form-password" style="display: none;">
          <div class="form-group">
            <label for="current-password"><i class="fas fa-key"></i> Current Password</label>
            <input type="password" id="current-password" name="currentPassword" placeholder="••••••••" required />
          </div>
          <div class="form-group">
            <label for="new-password"><i class="fas fa-lock"></i> New Password</label>
            <input type="password" id="new-password" name="newPassword" placeholder="••••••••" required />
          </div>
          <div class="form-group">
            <label for="confirm-password"><i class="fas fa-check-circle"></i> Confirm Password</label>
            <input type="password" id="confirm-password" name="confirmPassword" placeholder="••••••••" required />
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-cancel cancel-edit-btn">Cancel</button>
            <button type="submit" class="btn btn-save"><i class="fas fa-save"></i> Change Password</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal para detalles de reserva -->
    <div class="modal-overlay" id="reservaDetailsModal">
      <div class="modal-container">
        <div class="modal-header">
          <h2><i class="fas fa-clipboard-list"></i> Booking Details</h2>
          <button class="modal-close" id="btn-close-details-modal">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="modal-body">
          <div class="booking-summary">
            <h3 id="detail-id" style="color: #0968ef; text-align: center; border-bottom: 2px dashed #ccc; padding-bottom: 10px;">ID: #000</h3>
            <div class="summary-grid mt-3">
              <div class="summary-item"><i class="fas fa-plane-departure"></i><div><strong>Entry</strong><span id="detail-entry">-</span></div></div>
              <div class="summary-item"><i class="fas fa-plane-arrival"></i><div><strong>Exit</strong><span id="detail-exit">-</span></div></div>
              <div class="summary-item"><i class="fas fa-concierge-bell"></i><div><strong>Service</strong><span id="detail-service">-</span></div></div>
              <div class="summary-item"><i class="fas fa-car"></i><div><strong>Vehicle</strong><span id="detail-vehicle">-</span></div></div>
            </div>
            <div class="summary-price mt-3" style="display: flex; justify-content: space-between; align-items: center;">
              <span id="detail-status" class="badge">ESTADO</span>
              <strong style="font-size: 1.2rem;">Total: <span id="detail-price">0.00 €</span></strong>
            </div>
          </div>
          
          <div class="modal-actions mt-4" id="detail-actions" style="display: none; justify-content: space-between;">
            <button class="btn btn-danger" id="btn-cancel-reservation"><i class="fas fa-times-circle"></i> Cancel Booking</button>
            <button class="btn btn-primary" id="btn-edit-reservation"><i class="fas fa-edit"></i> Edit Booking</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal para editar reserva -->
    <div class="modal-overlay" id="editReservaModal">
      <div class="modal-container">
        <div class="modal-header">
          <h2><i class="fas fa-edit"></i> Edit Booking</h2>
          <button class="modal-close" id="btn-close-edit-reserva-modal">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <form class="modal-body" id="form-edit-reserva">
          <input type="hidden" id="edit-res-id" name="id_reservation" />
          
          <div class="form-row">
            <div class="form-group">
              <label for="edit-res-entrada"><i class="fas fa-plane-departure"></i> Entry Date</label>
              <input type="datetime-local" id="edit-res-entrada" name="entry_date" required />
            </div>
            <div class="form-group">
              <label for="edit-res-exit"><i class="fas fa-plane-arrival"></i> Exit Date</label>
              <input type="datetime-local" id="edit-res-exit" name="exit_date" required />
            </div>
          </div>

          <div class="form-group mt-3">
            <label><i class="fas fa-gem"></i> Main Service</label>
            <select id="edit-res-service" name="id_main_service" required>
                <option value="" disabled>Select a parking service...</option>
                <% if (locals.mainServices) { mainServices.forEach(ms => { %>
                    <option value="<%= ms.id_main_service %>"><%= ms.name %> (<%= ms.tagline %>)</option>
                <% }) } %>
            </select>
          </div>

          <div class="form-group mt-3">
            <label><i class="fas fa-plus-circle"></i> Additional Services</label>
            <div class="extras-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <% if (locals.additionalServices) { additionalServices.forEach(extra => { %>
                    <label class="extra-checkbox">
                        <input type="checkbox" class="edit-extra-serv" value="<%= extra.id_additional_service %>">
                        <%= extra.name %>
                    </label>
                <% }) } %>
            </div>
          </div>
          
          <div class="booking-price-preview has-price mt-3 text-center">
            <i class="fas fa-info-circle"></i> 
            <span style="font-size: 0.9rem; color: #666;">Changing details will recalculate the total price.</span>
          </div>

          <div class="modal-actions mt-4">
            <button type="button" class="btn btn-cancel" id="btn-cancel-edit-res">Cancel</button>
            <button type="submit" class="btn btn-save"><i class="fas fa-save"></i> Request Update</button>
          </div>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/javascripts/profile.js"></script>
  </body>
</html>