<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página de Registro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link rel="stylesheet" href="/stylesheets/register.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
  </head>
  <body>
    <div class="contenedor_general">
      <div class="contenedor_principal">
        <h1>PaparcApp</h1>
        <p>Register on our website</p>

        <!-- Modificar para que muestre errores de registro, puede ser un alert, ventana modal o un div. (lo que mas coraje te de)-->
        <% if (locals.error) { %>
            <div style="background-color: #ffcccc; color: #cc0000; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center; font-weight: bold;">
                <%= error %>
            </div>
        <% } %>

        <form action="/users/register" method="POST">
          <div class="secciones">
            <label for="full_name">Name and Surname</label> 
            <input
              type="text"
              name="full_name"
              id="full_name"
              value="<%= locals.formData ? locals.formData.full_name : '' %>"
              required
              minlength="3"
              maxlength="50"
            /> <!-- value con variables EJS, si el usuario tuvo un error en el formulario, se mantiene el valor -->
          </div>
          <div class="secciones">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" value="<%= locals.formData ? locals.formData.email : '' %>" required /> <!-- value con variables EJS, si el usuario tuvo un error en el formulario, se mantiene el valor -->
          </div>
          <div class="secciones">
            <label for="password">Password</label>
            <input
              type="password"
              name="password"
              id="password"
              required
              minlength="8"
              pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
              title="Must contain at least one number, one uppercase, one lowercase, and one special character"
            />
          </div>
          <div class="secciones">
            <label for="confirm_password">Confirm Password</label>
            <input
              type="password"
              name="confirm_password"
              id="confirm_password"
              required
              minlength="8"
            />
          </div>
          <button type="submit">Register</button>
        </form>
        <hr />
        <div class="botones">
          <button type="button" onclick="loginWithGoogle()">
            <img
              src="https://www.svgrepo.com/show/475656/google-color.svg"
              alt="Google logo"
            />
            <span>Continue with Google</span>
          </button>
          <button type="button" onclick="loginWithFacebook()">
            <img
              src="https://www.svgrepo.com/show/475647/facebook-color.svg"
              alt="Facebook logo"
            />
            <span>Continue with Facebook</span>
          </button>
        </div>
        <a href="/" class="back-home">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/></svg>
          Volver a inicio
        </a>
      </div>
      <div class="imagen">
        <img
          src="/images/interior-del-coche-jambzg90306g9tjn.jpg"
          alt="Portal de Acceso"
        />
      </div>
    </div>
    <!-- Firebase Auth -->
    <script src="/javascripts/firebase-config.js"></script>
    <script src="/javascripts/firebase-auth.js"></script>
  </body>
</html>
