<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva Reserva - PaparcApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/dashboard.css">
</head>
<body>
    <!-- Navbar (mismo que dashboard) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary sticky-top shadow-lg">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="/admin/dashboard">
                <i class="bi bi-p-circle-fill fs-3 me-2"></i>
                <span class="brand-text">PaparcApp</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/admin/dashboard">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active px-3" href="/admin/dashboard/dashboard_booking">
                            <i class="bi bi-calendar-plus me-1"></i> Nueva Reserva
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/history">
                            <i class="bi bi-clock-history me-1"></i> Historial
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#" role="button" data-bs-toggle="dropdown">
                            <div class="avatar-circle me-2">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <span class="d-none d-md-inline"><%= user.nombre %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                            <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/users/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <div class="welcome-header py-4 mb-4">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-6 fw-bold text-dark mb-1">
                        <i class="bi bi-calendar-plus text-primary me-2"></i>Nueva Reserva
                    </h1>
                    <p class="text-muted mb-0">Completa los pasos para reservar tu plaza de aparcamiento</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="container-fluid px-4 pb-5" id="booking-form-section">
        <div class="row g-4">

            <!-- Columna 1: Fechas -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-gradient-primary text-white border-0 py-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-calendar-event me-2"></i>Fechas
                        </h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="mb-3">
                            <label for="book-entrada" class="form-label fw-semibold">
                                <i class="bi bi-box-arrow-in-right text-success me-1"></i> Fecha de Entrada
                            </label>
                            <input type="datetime-local" class="form-control form-control-lg" id="book-entrada" required>
                        </div>
                        <div class="mb-3">
                            <label for="book-salida" class="form-label fw-semibold">
                                <i class="bi bi-box-arrow-left text-danger me-1"></i> Fecha de Salida
                            </label>
                            <input type="datetime-local" class="form-control form-control-lg" id="book-salida" required>
                        </div>
                        <div class="alert alert-light border d-flex align-items-center mt-auto mb-0" id="booking-price-preview">
                            <i class="bi bi-tag-fill text-primary me-2 fs-5"></i>
                            <span>Selecciona las fechas para ver el precio estimado</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna 2: Datos del Cliente y Vehículo -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-gradient-success text-white border-0 py-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-car-front me-2"></i>Cliente y Vehículo
                        </h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column gap-3">
                        <div>
                            <label for="book-nombre" class="form-label fw-semibold">
                                <i class="bi bi-person me-1"></i> Nombre completo
                            </label>
                            <input type="text" class="form-control" id="book-nombre" placeholder="Nombre y Apellidos" required>
                        </div>
                        <div>
                            <label for="book-email" class="form-label fw-semibold">
                                <i class="bi bi-envelope me-1"></i> Correo electrónico
                            </label>
                            <input type="email" class="form-control" id="book-email" placeholder="correo@ejemplo.com" required>
                        </div>
                        <div>
                            <label for="book-telefono" class="form-label fw-semibold">
                                <i class="bi bi-telephone me-1"></i> Teléfono
                            </label>
                            <input type="tel" class="form-control" id="book-telefono" placeholder="+34 600 123 456" required>
                        </div>
                        <div>
                            <label for="book-matricula" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1"></i> Matrícula
                            </label>
                            <input type="text" class="form-control" id="book-matricula" placeholder="0000-XXX" required>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="book-marca" class="form-label fw-semibold">
                                    <i class="bi bi-car-front-fill me-1"></i> Marca
                                </label>
                                <input type="text" class="form-control" id="book-marca" placeholder="Marca" required>
                            </div>
                            <div class="col-6">
                                <label for="book-modelo" class="form-label fw-semibold">
                                    <i class="bi bi-car-front me-1"></i> Modelo
                                </label>
                                <input type="text" class="form-control" id="book-modelo" placeholder="Modelo" required>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna 3: Resumen y Confirmación -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-gradient-warning text-white border-0 py-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-clipboard-check me-2"></i>Resumen
                        </h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block"><i class="bi bi-box-arrow-in-right me-1"></i> Entrada</small>
                                    <strong id="sum-entrada" class="text-truncate d-block" style="font-size: 0.85rem;">-</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block"><i class="bi bi-box-arrow-left me-1"></i> Salida</small>
                                    <strong id="sum-salida" class="text-truncate d-block" style="font-size: 0.85rem;">-</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block"><i class="bi bi-person me-1"></i> Cliente</small>
                                    <strong id="sum-nombre" class="text-truncate d-block">-</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block"><i class="bi bi-envelope me-1"></i> Email</small>
                                    <strong id="sum-email" class="text-truncate d-block">-</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i> Teléfono</small>
                                    <strong id="sum-telefono" class="text-truncate d-block">-</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block"><i class="bi bi-card-text me-1"></i> Matrícula</small>
                                    <strong id="sum-matricula" class="text-truncate d-block">-</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block"><i class="bi bi-car-front me-1"></i> Vehículo</small>
                                    <strong id="sum-vehiculo" class="text-truncate d-block">-</strong>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-success d-flex align-items-center justify-content-between fs-5 mb-3">
                            <span><i class="bi bi-tag-fill me-2"></i> Total:</span>
                            <strong id="sum-precio">0.00 €</strong>
                        </div>
                        <div class="d-grid gap-2 mt-auto">
                            <button type="button" class="btn btn-success btn-lg rounded-pill" onclick="confirmBooking()">
                                <i class="bi bi-check-lg me-1"></i> Confirmar Reserva
                            </button>
                            <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-pill">
                                <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Sección de Éxito (oculta por defecto) -->
        <div class="row justify-content-center mt-4" id="booking-step-success" style="display: none;">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <div class="mb-3">
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                        </div>
                        <h2 class="fw-bold mb-2">¡Reserva Confirmada!</h2>
                        <p class="text-muted">Tu código de reserva es:</p>
                        <div class="badge bg-primary fs-4 px-4 py-2 mb-3" id="codigo-reserva"></div>
                        <div id="qr-reserva" class="mb-3"></div>
                        <div class="row justify-content-center g-2 mb-4">
                            <div class="col-auto"><span class="badge bg-light text-dark border px-3 py-2"><i class="bi bi-person me-1"></i> <span id="conf-nombre"></span></span></div>
                            <div class="col-auto"><span class="badge bg-light text-dark border px-3 py-2"><i class="bi bi-envelope me-1"></i> <span id="conf-email"></span></span></div>
                            <div class="col-auto"><span class="badge bg-light text-dark border px-3 py-2"><i class="bi bi-telephone me-1"></i> <span id="conf-telefono"></span></span></div>
                            <div class="col-auto"><span class="badge bg-light text-dark border px-3 py-2"><i class="bi bi-card-text me-1"></i> <span id="conf-matricula"></span></span></div>
                            <div class="col-auto"><span class="badge bg-light text-dark border px-3 py-2"><i class="bi bi-car-front me-1"></i> <span id="conf-vehiculo"></span></span></div>
                        </div>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="/admin/dashboard" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                            <a href="/profile" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-person me-1"></i> Mi Perfil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer_dashboard') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/booking.js"></script>
</body>
</html>
