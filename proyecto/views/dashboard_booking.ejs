<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Booking - PaparcApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/dashboard.css">
    <link rel="stylesheet" href="/stylesheets/reservation-details.css"> 
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary sticky-top shadow-lg">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="/admin/dashboard">
                <i class="bi bi-p-circle-fill fs-3 me-2"></i>
                <span class="brand-text">PaparcApp</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/admin/dashboard">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active px-3" href="/admin/dashboard/dashboard_booking">
                            <i class="bi bi-calendar-plus me-1"></i> New Booking
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/admin/history">
                            <i class="bi bi-clock-history me-1"></i> History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/admin/dashboard/parking">
                            <i class="bi bi-car-front me-2"></i>Real-Time Parking
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#" role="button" data-bs-toggle="dropdown">
                            <div class="avatar-circle me-2">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <span class="d-none d-md-inline"><%= user.nombre %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                            <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/users/logout"><i class="bi bi-box-arrow-right me-2"></i>Log Out</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="page-header py-2 mb-2">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1" style="font-size: 0.82rem;">
                            <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none" style="color: #667eea;">Dashboard</a></li>
                            <li class="breadcrumb-item active">New Manual Booking</li>
                        </ol>
                    </nav>
                    <h2 class="h5 fw-bold mb-0">
                        <i class="bi bi-calendar-plus text-primary me-2"></i>Create Booking
                    </h2>
                </div>
                <div class="col-md-4 text-md-end mt-1 mt-md-0">
                        <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                </div>
            </div>
        </div>
    </div>

    <main class="container-fluid px-4 pb-3" id="booking-form-section">
        <form id="createReservationForm" action="/admin/reservations/new" method="POST">
            <div class="row g-2">

                <div class="col-lg-8 d-flex flex-column gap-2">
                    
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="detail-card h-100 shadow-sm border-0">
                                <div class="card-header bg-gradient-primary text-white py-2"> 
                                    <i class="bi bi-person-vcard mb-0"></i> Customer Details
                                </div>
                                <div class="card-body p-3"> 
                                    <div class="row g-2"> 
                                        <div class="col-12">
                                            <label class="form-label small text-muted mb-1" for="full_name">Full Name</label>
                                            <input type="text" class="form-control form-control-sm form-listener" id="full_name" name="full_name" placeholder="e.g. John Smith" required>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label small text-muted mb-1" for="phone">Phone</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone"></i></span>
                                                <input type="tel" class="form-control border-start-0 form-listener" id="phone" name="phone" placeholder="600 123 456" required>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label small text-muted mb-1" for="email">Email</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                                                <input type="email" class="form-control border-start-0 form-listener" id="email" name="email" placeholder="email@example.com" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card h-100 shadow-sm border-0">
                                <div class="card-header bg-gradient-secondary text-white py-2">
                                    <i class="bi bi-car-front-fill"></i> Vehicle Information
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label small text-muted mb-1" for="license_plate">License Plate</label>
                                            <input type="text" class="form-control form-control-sm fw-bold text-uppercase form-listener" id="license_plate" name="license_plate" placeholder="0000XXX" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="brand">Brand</label>
                                            <input type="text" class="form-control form-control-sm" id="brand" name="brand" placeholder="e.g. Toyota" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="model">Model</label>
                                            <input type="text" class="form-control form-control-sm" id="model" name="model" placeholder="e.g. Corolla" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="color">Color</label>
                                            <input type="text" class="form-control form-control-sm" id="color" name="color" placeholder="White">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small text-muted mb-1" for="calc_vehicle_type">Type</label>
                                            <select class="form-select form-select-sm" id="calc_vehicle_type" name="vehicle_type">
                                                <% vehicleTypes.forEach(v => { %>
                                                    <option value="<%= v.type %>"><%= v.type %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="detail-card shadow-sm border-0">
                        <div class="card-header text-white py-2" style="background: var(--gradient-success);">
                            <i class="bi bi-calendar-range"></i> Dates & Services
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1" for="calc_entry_date">
                                        <i class="bi bi-box-arrow-in-right text-success me-1"></i>Entry Date
                                    </label>
                                    <input type="datetime-local" class="form-control form-control-sm form-listener" id="calc_entry_date" name="entry_date" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1" for="calc_exit_date">
                                        <i class="bi bi-box-arrow-left text-danger me-1"></i>Exit Date
                                    </label>
                                    <input type="datetime-local" class="form-control form-control-sm form-listener" id="calc_exit_date" name="exit_date" required>
                                </div>
                                <div class="col-12 mt-2">
                                    <label class="form-label small text-muted mb-1" for="calc_main_service">Main Service</label>
                                    <select class="form-select form-select-sm" id="calc_main_service" name="id_main_service">
                                        <option value="" disabled selected>Select a service...</option>
                                        <% mainServices.forEach(ms => { %>
                                            <option value="<%= ms.id_main_service %>"><%= ms.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-12 mt-2">
                                    <label class="form-label small text-muted mb-1">Additional Services (Extras)</label>
                                    <div class="row g-2" id="additional_services_container">
                                        <% additionalServices.forEach(extra => { %>
                                            <div class="col-6 col-xl-4">
                                                <div class="extra-checkbox-card p-1 border rounded d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                                                    <input class="form-check-input calc_extra_service m-0 ms-1" type="checkbox" name="additional_services" value="<%= extra.id_additional_service %>" id="extra_<%= extra.id_additional_service %>">
                                                    <label class="form-check-label flex-grow-1 text-truncate mb-0" for="extra_<%= extra.id_additional_service %>" style="cursor:pointer;" title="<%= extra.name %>">
                                                        <%= extra.name %>
                                                    </label>
                                                        <span class="extra-price me-1 fw-medium">+<%= extra.price %>€</span>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-lg-4">
                    <div class="sidebar-wrapper d-flex flex-column gap-2 sticky-lg-top" style="top: 80px;">
                        
                        <div class="detail-card shadow-sm border-0">
                            <div class="card-header text-white py-2" style="background: var(--gradient-warning);">
                                <i class="bi bi-clipboard-check"></i> Live Summary
                            </div>
                            <div class="card-body p-2 bg-light">
                                <ul class="list-group list-group-flush small bg-transparent">
                                    <li class="list-group-item bg-transparent px-2 py-1 d-flex justify-content-between">
                                        <span class="text-muted"><i class="bi bi-person me-1"></i> Customer:</span>
                                        <strong id="sum-nombre" class="text-truncate text-end" style="max-width: 150px;">-</strong>
                                    </li>
                                    <li class="list-group-item bg-transparent px-2 py-1 d-flex justify-content-between">
                                        <span class="text-muted"><i class="bi bi-card-text me-1"></i> License Plate:</span>
                                        <strong id="sum-matricula" class="text-uppercase">-</strong>
                                    </li>
                                    <li class="list-group-item bg-transparent px-2 py-1 d-flex justify-content-between">
                                        <span class="text-muted"><i class="bi bi-box-arrow-in-right text-success me-1"></i> Entry:</span>
                                        <strong id="sum-entrada">-</strong>
                                    </li>
                                    <li class="list-group-item bg-transparent px-2 py-1 border-bottom-0 d-flex justify-content-between">
                                        <span class="text-muted"><i class="bi bi-box-arrow-left text-danger me-1"></i> Exit:</span>
                                        <strong id="sum-salida">-</strong>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="price-card p-3 shadow-sm border-0">
                            <div class="position-relative" style="z-index:1;">
                                <h6 class="text-white-50 mb-1 small"><i class="bi bi-tag-fill me-1"></i> Total Quote</h6>
                                <div class="d-flex align-items-baseline gap-1">
                                    <span class="price-amount fs-2 fw-bold" id="dynamic_total_price">0.00</span> 
                                    <span class="price-currency fs-5">€</span>
                                </div>
                                <span id="recalculating_indicator" style="display:none; font-size: 0.8rem;">
                                    <i class="bi bi-arrow-repeat"></i> Calculating price...
                                </span>
                            </div>
                            
                            <div class="d-grid gap-2 mt-3 pt-3 border-top border-light border-opacity-25">
                                <button type="submit" id="btn_confirm_booking" class="btn btn-save-main btn-sm py-2 shadow-sm btn-submit-dynamic">
                                    <i class="bi bi-check-circle-fill me-1"></i> Confirm Booking
                                </button>
                                <button type="reset" class="btn btn-cancel-main btn-sm py-1">
                                    <i class="bi bi-trash me-1"></i> Clear Form
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </form>

        <div class="row justify-content-center mt-4" id="booking-step-success" style="display: none;">
            </div>

    </main>

    <%- include('partials/footer_dashboard') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/javascripts/dynamic-pricing.js"></script>
    
    <script src="/javascripts/booking.js"></script>
</body>
</html>
</body>
</html>