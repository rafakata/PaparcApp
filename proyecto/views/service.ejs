<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - PaparcApp</title>
    <link rel="stylesheet" href="/stylesheets/service.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
  </head>
  <body>
    <header class="header">
      <!-- NAVBAR -->
      <nav class="nav">
        <div class="logo">
          <a href="/">PaparcApp</a>
        </div>
        <div class="lista">
          <ul>
            <li><a href="/service">Service</a></li>
            <li><a href="">Price</a></li>
            <li><a href="">920 452 748</a></li>
          </ul>
        </div>
        <div class="acceso">
          <ul>
            <li class="sign_up">
              <a href="/register"><i class="fas fa-user-plus"></i> Sign up</a>
            </li>
            <li class="login">
              <a href=""><i class="fas fa-sign-in-alt"></i> Login</a>
            </li>
          </ul>
        </div>
      </nav>
    </header>
    <main>
      <div class="contenedor_h1">
        <h1>Nuestros Servicios</h1>
      </div>
      <div class="contenedor_principal">
        <div class="contenedor">
          <div class="servicios_lista">
            <!-- Servicio 1 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img src="/images/3c63af1d-c905-4c85-a68b-a20096b81ab1.png" alt="Reserva de Aparcamiento" />
              </div>
              <div class="servicio_descripcion">
                <h3>Reserva de Aparcamiento</h3>
                <p>
                  Reserva tu plaza de aparcamiento con antelación y garantiza tu espacio. 
                  Disponible 24/7 en múltiples ubicaciones estratégicas de la ciudad.
                </p>
              </div>
            </div>
            <!-- Servicio 2 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img src="/images/foto-fotograma-completo-coloridos-coches-colocados-aparcamiento_1048944-15446093.jpg" alt="Gestión de Plazas" />
              </div>
              <div class="servicio_descripcion">
                <h3>Gestión de Plazas</h3>
                <p>
                  Gestiona tus reservas de forma sencilla e intuitiva. Visualiza disponibilidad, 
                  modifica tus reservas y recibe notificaciones en tiempo real.
                </p>
              </div>
            </div>
            <!-- Servicio 3 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img src="/images/unnamed.jpg" alt="Garajes Privados" />
              </div>
              <div class="servicio_descripcion">
                <h3>Garajes Privados</h3>
                <p>
                  Accede a garajes privados seguros y protegidos. Espacios cubiertos con 
                  sistemas de seguridad avanzados para tu tranquilidad.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <footer>
      <div class="footer_contenido">
        <hr />
        <div class="contenedor_footer">
          <div class="footer_enlaces">
            <div class="footer_enlace">
              <p>Account</p>
              <ul>
                <li>Profile</li>
                <li>Settings</li>
                <li>Billing</li>
              </ul>
            </div>
            <div class="footer_enlace">
              <p>About</p>
              <ul>
                <li>Services</li>
                <li>Pricing</li>
                <li>Contact</li>
              </ul>
            </div>
            <div class="footer_enlace">
              <p>Company</p>
              <ul>
                <li>Community</li>
                <li>Help center</li>
                <li>Support</li>
              </ul>
            </div>
          </div>
          <div class="footer_logo">
            <div class="footer_logo_inner">
              <p>PaparcApp</p>
              <ul>
                <li>
                  <a href="#"><i class="fa-brands fa-instagram"></i></a>
                </li>
                <li>
                  <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
                </li>
                <li><a href="">920 452 748</a></li>
              </ul>
            </div>
          </div>
        </div>
        <hr />
        <div class="derechos">
          <p>
            @ 2026 All Right Reserved by <span>Rafael Medina</span> -
            <span>Hamza Satori</span> - <span>Javier Cabrera</span>
          </p>
          <ul>
            <li><a href="/privacy">Terms</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
