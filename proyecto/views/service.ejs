<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - PaparcApp</title>
    <link rel="stylesheet" href="/stylesheets/service.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Zen+Dots&display=swap" rel="stylesheet">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
  </head>
  <body>
    <header class="header">
      <!-- NAVBAR -->
      <%- include("partials/nav") %>
    </header>

    <div style="background: #282c34; color: #abb2bf; padding: 20px; border-radius: 8px; margin: 20px; font-family: monospace; overflow-x: auto; border-left: 5px solid #c678dd;">
      <h3 style="color: #e5c07b; margin-top: 0;">📦 JSON para Frontend: service.ejs</h3>
      <pre><%- JSON.stringify({ mainServices }, null, 2) %></pre>
    </div>

    <main>
      <div class="contenedor_h1">
        <h1>Our Services</h1>
      </div>
      <div class="contenedor_principal">
        <div class="contenedor">
          <div class="servicios_lista">
            <!-- Servicio 1 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img loading="lazy" src="/images/3c63af1d-c905-4c85-a68b-a20096b81ab1.png" alt="Reserva de Aparcamiento" />
              </div>
              <div class="servicio_descripcion">
                <h3>Parking Reservation</h3>
                <p>
                  Book your parking space in advance and secure your spot. Available 24/7 at strategic city locations near Málaga Airport.
                </p>
              </div>
            </div>
            <!-- Servicio 2 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img loading="lazy" src="/images/foto-fotograma-completo-coloridos-coches-colocados-aparcamiento_1048944-15446093.jpg" alt="Gestión de Plazas" />
              </div>
              <div class="servicio_descripcion">
                <h3>Space Management</h3>
                <p>
                  Easily manage your bookings with intuitive tools. Check availability, modify reservations, and get real-time notifications.
                </p>
              </div>
            </div>
            <!-- Servicio 3 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img loading="lazy" src="/images/unnamed.jpg" alt="Garajes Privados" />
              </div>
              <div class="servicio_descripcion">
                <h3>Private Garages</h3>
                <p>
                 Access secure private garages with advanced protection. Covered spaces featuring CCTV and gated entry for complete peace of mind.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
      <%- include("partials/footer") %>
  </body>
</html>
