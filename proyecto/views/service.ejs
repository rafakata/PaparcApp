<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - PaparcApp</title>
    <link rel="stylesheet" href="/stylesheets/service.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Zen+Dots&display=swap" rel="stylesheet">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="icon" href="/images/icons8-garage-24.png" type="image/png" />
  </head>
  <body>
    <header class="header">
      <!-- NAVBAR -->
      <%- include("partials/nav") %>
    </header>
    <main>
      <div class="contenedor_h1">
        <h1>Our Services</h1>
      </div>
      <div class="contenedor_principal">
        <div class="contenedor">
          <div class="servicios_lista">
            <!-- Servicio 1 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img loading="lazy" src="/images/3c63af1d-c905-4c85-a68b-a20096b81ab1.png" alt="Online parking reservation at Malaga Airport - PaparcApp" />
              </div>
              <div class="servicio_descripcion">
                <h3>Parking Reservation at Malaga Airport</h3>
                <p>
                  Reserve your parking spot online at Malaga Airport with PaparcApp. Guaranteed availability 24/7 in secure, strategic locations close to the terminal. Hassle-free and fast booking process.
                </p>
              </div>
            </div>
            <!-- Servicio 2 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img loading="lazy" src="/images/foto-fotograma-completo-coloridos-coches-colocados-aparcamiento_1048944-15446093.jpg" alt="Parking space management and booking control - PaparcApp" />
              </div>
              <div class="servicio_descripcion">
                <h3>Parking Space Management Tools</h3>
                <p>
                  Manage your parking bookings efficiently with PaparcApp. Check real-time availability, modify or cancel reservations, and receive instant notifications. Optimize your parking experience with our user-friendly management tools.
                </p>
              </div>
            </div>
            <!-- Servicio 3 -->
            <div class="servicio_fila">
              <div class="servicio_imagen">
                <img loading="lazy" src="/images/unnamed.jpg" alt="Secure private garages with CCTV and gated entry - PaparcApp" />
              </div>
              <div class="servicio_descripcion">
                <h3>Secure Private Garages Malaga</h3>
                <p>
                 Access secure private garages in Malaga with advanced protection. Covered parking spaces with CCTV surveillance and gated entry ensure maximum security and peace of mind for your vehicle.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
      <%- include("partials/footer") %>
  </body>
</html>
